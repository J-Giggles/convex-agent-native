{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"noEmit": false,
		"incremental": false
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
