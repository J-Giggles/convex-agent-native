{
  "name": "@giggabit/convex-agent-native-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --dir .. build",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "predeploy": "pnpm --dir .. build",
    "deploy": "convex deploy --typecheck enable",
    "pretest": "pnpm --dir .. build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --dir .. build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-native/core": "0.189.0",
    "@giggabit/agent-native-convex": "link:..",
    "convex": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "convex-test": "0.0.54",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.22.0 <27"
  }
}
